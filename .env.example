# --- Backend ---
APP_ENV=development
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres (docker-compose dev)
DATABASE_URL=postgresql+psycopg://lastmile:lastmile@localhost:5432/lastmile

# For Supabase prod, override:
# DATABASE_URL=postgresql+psycopg://postgres:<pw>@db.<proj>.supabase.co:5432/postgres?sslmode=require

# AI
LLM_PROVIDER=mock          # mock | deepseek | claude
LLM_API_KEY=
LLM_MODEL=

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Frontend (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
